{
  "name": "litscout",
  "version": "0.1.0",
  "description": "Self-hosted scholarly literature MCP server.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "semantic-scholar",
    "openalex",
    "arxiv",
    "openreview",
    "literature-search",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eryc123Y/litscout-mcp.git"
  },
  "homepage": "https://github.com/Eryc123Y/litscout-mcp#readme",
  "bugs": {
    "url": "https://github.com/Eryc123Y/litscout-mcp/issues"
  },
  "files": [
    "dist",
    "wrangler.template.jsonc",
    "README.md",
    "LICENSE",
    "docs/venue-data-licence.md"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:live": "vitest run --config vitest.live.config.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "zod": "4.6.7",
    "wrangler": "4.151.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.0.3"
  },
  "bin": {
    "litscout": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  }
}
