{
  "name": "litscout",
  "main": "WORKER_BUNDLE_PATH",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "PUBLIC_URL": "https://YOUR_WORKER_HOST",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "KV_NAMESPACE_ID",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SOURCE_LIMITER",
        "class_name": "SourceLimiter",
      },
      {
        "name": "PAIRING_STORE",
        "class_name": "PairingStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SourceLimiter", "PairingStore"],
    },
  ],
  "send_metrics": false,
}
